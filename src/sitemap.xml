<?xml version="1.0" encoding="UTF-8"?>
<!--
  Sitemap: the list of pages search engines should index, with how often they change and how important
  each is (1.0 is the front page). build.py fills in the site address and today's date when it builds.
  When a page is added to the site, add it here too; build.py checks every page in its list is listed.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url><loc>{{SITE_URL}}</loc><lastmod>{{TODAY}}</lastmod><changefreq>weekly</changefreq><priority>1.0</priority></url>
  <url><loc>{{SITE_URL}}use-cases.html</loc><lastmod>{{TODAY}}</lastmod><changefreq>weekly</changefreq><priority>0.9</priority></url>
  <url><loc>{{SITE_URL}}methodology.html</loc><lastmod>{{TODAY}}</lastmod><changefreq>weekly</changefreq><priority>0.9</priority></url>
  <url><loc>{{SITE_URL}}case-against.html</loc><lastmod>{{TODAY}}</lastmod><changefreq>weekly</changefreq><priority>0.8</priority></url>
  <url><loc>{{SITE_URL}}llms.txt</loc><lastmod>{{TODAY}}</lastmod><changefreq>weekly</changefreq><priority>0.6</priority></url>
</urlset>
